        tween(textBox, infoSlow, {BackgroundTransparency = 1, TextTransparency = 1}):Play()
        tween(textStroke, infoSlow, {Transparency = 1}):Play()
        tween(button, infoSlow, {BackgroundTransparency = 1, TextTransparency = 1}):Play()
        tween(getKeyButton, infoSlow, {BackgroundTransparency = 1, TextTransparency = 1}):Play()
        tween(getKeyStroke, infoSlow, {Transparency = 1}):Play()
        tween(borderStroke, infoSlow, {Transparency = 1}):Play()
        
        task.wait(0.4)
        blurEffect:Destroy()
        screenGui:Destroy()
        loadstring(game:HttpGet("https://raw.githubusercontent.com"))()
    else
        -- Logic kapag MALI ang nilagay na key
        button.Text = "INVALID KEY"
        tween(button, infoFast, {BackgroundColor3 = Color3.fromRGB(150, 0, 0), TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
        
        task.wait(1.5)
        
        -- Ibalik sa orihinal na kulay red at text na "Verify"
        button.Text = "Verify"
        tween(button, infoFast, {BackgroundColor3 = Color3.fromRGB(255, 0, 0), TextColor3 = Color3.fromRGB(20, 0, 0)}):Play()
        
        -- Payagan ulit pumindot ang user para mag-retry
        isProcessing = false
    end
end)
