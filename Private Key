-- ⚙️ UX INTERACTION LOGIC
---------------------------------------------------------
local function applyHover(btn, norm, hov)
    btn.MouseEnter:Connect(function() TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = hov}):Play() end)
    btn.MouseLeave:Connect(function() TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = norm}):Play() end)
end
applyHover(verifyBtn, Color3.fromRGB(45, 48, 64), Color3.fromRGB(58, 62, 82))
applyHover(getKeyBtn, Color3.fromRGB(16, 185, 129), Color3.fromRGB(22, 210, 145))
applyHover(discordBtn, Color3.fromRGB(79, 70, 229), Color3.fromRGB(95, 85, 250))

local function showStatus(txt, col)
    statusLabel.Text = txt
    statusLabel.TextColor3 = col
end

verifyBtn.MouseButton1Click:Connect(function()
    local cleanInput = string.gsub(textBox.Text, "%s+", "")
    if cleanInput == CORRECT_KEY then
        showStatus("Access Granted! Executing runtime script...", Color3.fromRGB(16, 185, 129))
        task.wait(1)
        
        local close = TweenService:Create(mainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Size = UDim2.new(0,0,0,0)})
        close:Play()
        close.Completed:Connect(function()
            sgui:Destroy()
            print("Target Script loaded successfully via Xeno context.")
        end)
    else
        showStatus("Invalid key code. Please check again.", Color3.fromRGB(239, 68, 68))
        textBox.Text = ""
    end
end)

